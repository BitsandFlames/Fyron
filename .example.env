# Fyron env-based auth
FHIR_USER=your_username
FHIR_PASSWORD=your_password

# FHIR endpoints
FHIR_BASE_URL=https://example.org/fhir
FHIR_AUTH_URL=https://example.org/auth/token
FHIR_REFRESH_URL=https://example.org/auth/refresh

# FHIR SQL database connection
FHIR_DB_DSN=postgresql://user:password@localhost:5432/fhir
FHIR_DB_HOST=localhost
FHIR_DB_PORT=5432
FHIR_DB_NAME=fhir
FHIR_DB_USER=your_username
FHIR_DB_PASSWORD=your_password

# DICOMweb endpoint
DICOM_WEB_URL=https://pacs.example.org/dicomweb
DICOM_USER=your_username
DICOM_PASSWORD=your_password

# LLM Agent
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=your_api_key
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=30

# Teable
TEABLE_BASE_URL=https://app.teable.ai
TEABLE_TOKEN=your_teable_token
